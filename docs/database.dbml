// ==========================================
// SKALA 스마트 교육플랫폼 - 데이터 모델 (ERD)
// 과제 및 피드백 통합 관리 시스템
// ==========================================

// ==========================================
// Enum (상수 및 상태값 정의)
// ==========================================
Enum RoleType {
  ADMIN       [note: '시스템 관리자 (A로 시작하는 ID)']
  PROFESSOR   [note: '교수자/매니저 (M으로 시작하는 ID)']
  STUDENT     [note: '교육생 (S로 시작하는 ID)']
}

Enum UserStatus {
  PENDING     [note: '가입 승인 대기 (기본값)']
  APPROVED    [note: '승인 완료 - 로그인 가능']
  REJECTED    [note: '가입 반려']
}

Enum ActivityType {
  ASSIGNMENT  [note: '과제 - 파일 제출형']
  QUIZ        [note: '퀴즈 - 문항 응시형']
}

Enum QuestionType {
  MULTIPLE_CHOICE [note: '객관식 - 보기 중 정답 선택']
  SHORT_ANSWER    [note: '단답형 - 텍스트 입력 후 자동 채점']
}

Enum GradingStatus {
  PENDING     [note: '채점 대기']
  DONE        [note: '채점 완료']
}

// ==========================================
// Core Entities (핵심 개체)
// ==========================================

Table users {
  id varchar [primary key, note: 'PK: 사번(M) / 학번(S) / 관리자(A) - ID 접두사로 역할 자동 판별']
  password varchar [not null, note: '암호화된 비밀번호 (BCrypt 등)']
  name varchar [not null, note: '사용자 실명']
  role RoleType [not null, note: 'ID 접두사 기반 자동 배정 (A→ADMIN, M→PROFESSOR, S→STUDENT)']
  status UserStatus [not null, default: 'PENDING', note: '가입 승인 상태 - 관리자가 APPROVED로 변경 시 로그인 가능']
  class_name varchar [note: '학생 소속 반 (예: AI 3기 - 1반) - 관리자가 승인 시 함께 배정']
  created_at timestamp [not null, default: `now()`]
}

Table courses {
  id varchar [primary key, note: 'PK: 강좌 코드 (예: C-2026-01)']
  title varchar [not null, note: '강좌명']
  target_class varchar [not null, note: '대상 반 (예: AI 3기 - 1반) - users.class_name과 매칭']
  instructor_id varchar [not null, note: 'FK: 담당 교수 사번']
  start_date date [not null, note: '강좌 시작일']
  end_date date [not null, note: '강좌 종료일']
  created_at timestamp [not null, default: `now()`]
}

// ==========================================
// 수강 등록 (학생 ↔ 강좌 M:N 관계)
// ==========================================
// [수강 상태 처리 방식]
// 수강 상태(수강 예정 / 수강 중 / 수강 완료)는 별도 컬럼으로 저장하지 않고,
// courses.start_date / end_date와 현재 시각을 서버에서 비교하여 동적으로 계산합니다.
//   - 현재 시각 < start_date → SCHEDULED (수강 예정)
//   - start_date <= 현재 시각 <= end_date → IN_PROGRESS (수강 중)
//   - 현재 시각 > end_date → COMPLETED (수강 완료)
// 이 계산 결과는 GET /courses/my 응답의 enrollment_status 필드로 반환됩니다.

Table enrollments {
  id integer [primary key, increment, note: 'PK: 수강 등록 고유 ID']
  student_id varchar [not null, note: 'FK: 학생 ID']
  course_id varchar [not null, note: 'FK: 강좌 ID']
  enrolled_at timestamp [not null, default: `now()`, note: '수강 등록 시각 (관리자가 학생 승인 시 target_class 기준으로 자동 등록)']

  indexes {
    (student_id, course_id) [unique, note: '동일 학생의 같은 강좌 중복 등록 방지']
  }
}

// ==========================================
// Activity Entities (학습 활동 - 과제/퀴즈 통합)
// Single Table Inheritance 패턴 적용:
// type 컬럼으로 ASSIGNMENT / QUIZ 구분
// ==========================================

Table activities {
  id integer [primary key, increment, note: 'PK: 학습 활동 고유 ID']
  course_id varchar [not null, note: 'FK: 소속 강좌']
  type ActivityType [not null, note: '활동 구분 (ASSIGNMENT / QUIZ)']
  title varchar [not null, note: '활동 제목']
  content text [note: '가이드라인 및 상세 내용']
  deadline timestamp [not null, note: '제출/응시 마감 일시']

  // 과제(ASSIGNMENT) 전용 필드
  max_score integer [note: '총 배점. ASSIGNMENT: 교수자가 직접 입력한 값을 저장. QUIZ: 문항 등록 시 questions.score의 합산값을 서버에서 자동 계산하여 저장(동적 계산 아님). API 응답 시 항상 이 컬럼 값을 사용.']
  file_name varchar [note: '교수자 업로드 첨부파일명 (ASSIGNMENT 전용)']
  file_url varchar [note: '첨부파일 저장 경로 (ASSIGNMENT 전용)']

  // 퀴즈(QUIZ) 전용 필드
  time_limit integer [note: '제한 시간(분) - QUIZ 전용']
  max_attempts integer [note: '최대 응시 가능 횟수 - QUIZ 전용']

  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [note: '최종 수정 일시']
}

Table questions {
  id integer [primary key, increment, note: 'PK: 문항 고유 ID']
  activity_id integer [not null, note: 'FK: 소속 퀴즈 활동 ID']
  question_order integer [not null, note: '문항 표시 순서 (1부터 시작)']
  type QuestionType [not null, note: '문항 유형 (객관식 / 단답형)']
  score integer [not null, note: '해당 문항 배점']
  content text [not null, note: '문제 내용']
  correct_answer varchar [note: '단답형(SHORT_ANSWER) 자동 채점용 정답 텍스트']

  indexes {
    (activity_id, question_order) [unique, note: '같은 활동 내 문항 순서 중복 방지']
  }
}

Table question_options {
  id integer [primary key, increment, note: 'PK: 보기 고유 ID']
  question_id integer [not null, note: 'FK: 소속 문항 ID']
  option_order integer [not null, note: '보기 표시 순서 (1번부터)']
  content varchar [not null, note: '보기 내용 텍스트']
  is_correct boolean [not null, default: false, note: '정답 여부 (true = 정답 보기)']
}

// ==========================================
// Submission & Feedback (제출 및 피드백)
// ==========================================

Table submissions {
  id integer [primary key, increment, note: 'PK: 제출 고유 ID']
  activity_id integer [not null, note: 'FK: 대상 학습 활동 ID']
  student_id varchar [not null, note: 'FK: 제출 학생 ID']

  submitted_at timestamp [not null, note: '최초 제출 시각. activities.deadline보다 늦으면 지각 제출로 판별하며, API 응답 시 is_late 필드(boolean)로 계산하여 반환됨']
  updated_at timestamp [note: '최종 수정 시각 - 과제(ASSIGNMENT) 재제출 시 갱신. 퀴즈(QUIZ) 재응시 시에도 갱신되며(max_attempts 초과 전까지), 재응시 시 기존 quiz_answers 레코드를 모두 DELETE 후 신규 INSERT하여 최신 응시 결과만 유지함. max_attempts 초과 후에는 수정 불가.']
  time_taken integer [note: 'QUIZ 전용: 응시 소요 시간(초). 시간 초과 자동 제출 시에는 time_limit(분)*60 값이 저장됨. ASSIGNMENT의 경우 NULL.']

  // 과제 제출 관련
  file_name varchar [note: '학생 제출 파일명 (ASSIGNMENT 전용)']
  file_url varchar [note: '제출 파일 저장 경로 (ASSIGNMENT 전용)']

  // 채점 결과
  score decimal(5,2) [note: '획득 점수']
  feedback text [note: '교수자 피드백 내용']
  grading_status GradingStatus [not null, default: 'PENDING', note: '채점 상태']
  graded_at timestamp [note: '채점 완료 시각']

  created_at timestamp [not null, default: `now()`]

  indexes {
    (activity_id, student_id) [unique, note: '한 학생당 하나의 활동에 하나의 제출만 허용']
  }
}

Table quiz_answers {
  id integer [primary key, increment, note: 'PK: 답안 고유 ID']
  submission_id integer [not null, note: 'FK: 소속 제출 ID']
  question_id integer [not null, note: 'FK: 대상 문항 ID']
  student_answer text [note: '학생 입력 답안 (객관식: 보기번호 / 단답형: 텍스트)']
  is_correct boolean [note: '정답 여부 (자동 채점 결과)']
  earned_score integer [note: '획득 점수 (정답 시 해당 문항 배점, 오답 시 0)']

  indexes {
    (submission_id, question_id) [unique, note: '하나의 제출에서 같은 문항에 대한 중복 답안 방지']
  }
}

// ==========================================
// Relationships (테이블 간 관계 정의)
// ==========================================

// 강좌 → 교수자 (N:1)
Ref: courses.instructor_id > users.id

// 수강 등록 → 학생, 강좌 (M:N 해소 테이블)
Ref: enrollments.student_id > users.id
Ref: enrollments.course_id > courses.id

// 학습 활동 → 강좌 (N:1)
Ref: activities.course_id > courses.id

// 퀴즈 문항 → 학습 활동 (N:1)
Ref: questions.activity_id > activities.id

// 보기 → 문항 (N:1)
Ref: question_options.question_id > questions.id

// 제출 → 학습 활동, 학생 (N:1)
Ref: submissions.activity_id > activities.id
Ref: submissions.student_id > users.id

// 퀴즈 답안 → 제출, 문항 (N:1)
Ref: quiz_answers.submission_id > submissions.id
Ref: quiz_answers.question_id > questions.id
