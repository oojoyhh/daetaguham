# Docker Compose
POSTGRES_DB=daetaguham
POSTGRES_USER=daetaguham
POSTGRES_PASSWORD=change-me
DAETAGUHAM_DB_PORT=15432

# Spring Boot
DB_HOST=localhost
DB_PORT=15432
DB_NAME=daetaguham
DB_USERNAME=daetaguham
DB_PASSWORD=change-me
PORT=8080
HEALTH_SHOW_DETAILS=always
REQUEST_EXPIRATION_INITIAL_DELAY=PT30S
REQUEST_EXPIRATION_FIXED_DELAY=PT1M
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8767,http://localhost:8767,https://oojoyhh.github.io

# JWT - 배포 환경에서는 반드시 다른 32byte 이상 무작위 값을 사용하세요.
JWT_ISSUER=daetaguham
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_TTL=PT1H
